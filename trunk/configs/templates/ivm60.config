CONFIG_FIRMWARE_PRODUCT_ID="IVM60"
CONFIG_VENDOR=WayOS
CONFIG_PRODUCT=IVM60

# WayOS IVM-60 RT3883 + RTL8367RB 纯有线 GPIO bitbang（20/21）
CONFIG_RALINK_RT3883=y

# RTL8367RB交换机
CONFIG_RTL8367=y
CONFIG_RTL8367_ASIC_RB=y
# CONFIG_RTL8367_CIF_MDIO=y
CONFIG_RTL8367_RESET_GPIO=24
CONFIG_RTL8367_SMI_BUS_CPU_GPIO_DATA=20
CONFIG_RTL8367_SMI_BUS_CPU_GPIO_CLCK=21

# 端口映射
CONFIG_RTL8367_PORT_WAN=4
CONFIG_RTL8367_PORT_LAN1=0
CONFIG_RTL8367_PORT_LAN2=1
CONFIG_RTL8367_PORT_LAN3=2
CONFIG_RTL8367_PORT_LAN4=3

# RGMII
CONFIG_RALINK_RGMII=y
# CONFIG_RT3883_PHY=y

# 系统基础
CONFIG_MIPS16=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_BUSYBOX=y
CONFIG_USB_SUPPORT=y
CONFIG_FS_EXT4=y
CONFIG_FS_FAT=y
CONFIG_FS_NTFS=y
CONFIG_SWAP=y
CONFIG_IPV6=y
CONFIG_IGMP_SNOOPING=y
CONFIG_RTL8367_IGMP_SNOOPING=y

# WEB管理
CONFIG_HTTPD=y
CONFIG_HTTPD_TLS=y
CONFIG_AVAHI=y
CONFIG_DNSMASQ=y
CONFIG_DROPBEAR=y
CONFIG_WOL=y
CONFIG_NAT=y
CONFIG_QOS=y
CONFIG_SSH=y
CONFIG_SYSLOG=y
CONFIG_CROND=y
